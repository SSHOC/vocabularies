<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCFederation> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "network of EOSC Nodes that collectively integrate their resources to provide shared system-level functions, known as Federating Capabilities"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:note "The EOSC Federation is a system of systems, built as a distributed network of services to enable Open Science across disciplinary and national borders."@en,
        "The Federating Capabilities include a common catalogue for resource discovery, a federated user login system (AAI), and coordinated monitoring."@en ;
    skos:prefLabel "EOSC Federation"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

