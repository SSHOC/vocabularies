<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/AuthenticationAndAuthorisationInfrastructure> a skos:Concept ;
    dc:source "EOSC Future project glossary" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:altLabel "AAI"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Service> ;
    skos:definition "service (or distributed set of services) which enables users to be identified and to access protected information, other services or functionality"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:prefLabel "Authentication and Authorisation Infrastructure"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/CompetenceCentre> a skos:Concept ;
    dc:source "https://oscars-project.eu/clusters-open-science-competence-centres" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "virtual hub dedicated to fostering research excellence through training and knowledge transfer"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:note "Specifically in the context of OSCARS: community-based initiative supported by a collaborative science cluster network of people providing expertise, best practices and services in relation to Open Science, and the promotion of cross-disciplinary collaboration."@en ;
    skos:prefLabel "competence centre"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Composability> a skos:Concept ;
    dc:source "OSCARS D2.1 - Clusters' Services and Data Sources Portfolios;  https://zenodo.org/records/14881627;" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "ability to combine and integrate smaller, modular components or services into more complex systems."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:prefLabel "composability"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataCuration> a skos:Concept ;
