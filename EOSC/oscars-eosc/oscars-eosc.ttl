    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:prefLabel "data infrastructure"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataLifeCycle> a skos:Concept ;
    dc:source "EOSC Glossary September 2020" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Data> ;
    skos:definition "all stages in the existence of ​data​ from creation to destruction"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:prefLabel "data life-cycle"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataManagementPlan> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:altLabel "DMP"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataManagement> ;
    skos:definition "document specifying where, during and beyond the course of a research project, the data will be archived, which licenses and constraints for use apply, to whom credit should be given, etc."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:note "A variant is the notion of machine-actionable DMP (maDMP): a structured digital format for research data plans that allows systems and tools to automatically process project information and to enable the exchange of information between systems acting on behalf of stakeholders involved in the research life cycle, such as, researchers, funders, repository managers, ICT providers, librarians, etc."@en ;
    skos:prefLabel "data management plan"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataStewardship> a skos:Concept ;
    dc:source "EOSC Glossary September 2020" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataManagement> ;
    skos:definition "formalised ​data management and oversight of an ​organisation​'s ​data (by a data steward) to help provide ​end-users​ with high-quality data that is easily accessible in a consistent manner"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:note "A DMP specifies where the data will be archived, which licenses and constraints apply, to whom credit should be given, etc."@en ;
    skos:prefLabel "data stewardship"@en .

