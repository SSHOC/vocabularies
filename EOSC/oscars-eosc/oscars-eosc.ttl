        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ThematicService> ;
    skos:prefLabel "service"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ScienceCluster> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "collaborative framework that brings together research infrastructures from a specific scientific domain to align their capabilities, develop common solutions, and contribute domain-specific resources and services to EOSC"@en ;
    skos:example "ENVRI, ESCAPE, PaNOSC, LS-RI, SSHOC"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ENVRI>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ESCAPE>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/LifeScienceResearchInfrastructures>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/PaNOSC>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/SSHOC> ;
    skos:note "The five science clusters collaborate under network label 'Science Clusters'. See science-clusters.eu"@en ;
    skos:prefLabel "science cluster"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

