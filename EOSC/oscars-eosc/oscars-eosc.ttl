    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCNode> ;
    skos:definition "EOSC Node representing communities working in a specific scientific domain of research or with specific scientific techniques"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:prefLabel "thematic EOSC Node"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ThematicInfrastructure> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ResearchInfrastructure> ;
    skos:definition "research infrastructure that provides facilities, resources, and services tailored to the needs of a specific scientific domain, research community or thematic area"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:prefLabel "thematic infrastructure"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/TrainingResource> a skos:Concept ;
    dc:source "EOSC Future project glossary" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Resource> ;
    skos:definition "any resource – including print and non-print materials and online/open-access resources – that supports and enhances, directly or indirectly, learning and teaching"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:note "If a training resource is used in a training environment, for training activities that are part of a training plan and involve instructors, facilitators and students, then we speak of training materials."@en ;
    skos:prefLabel "training resource"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/VirtualResearchEnvironment> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:altLabel "VRE"@en ;
    skos:definition "temporary compute environment for tools and data, enabling researchers to work interactively and remotely."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:note "A VRE offers a complete desktop environment (e.g. based on notebook technology) that allows a researcher to provide/select data and execute a workflow."@en ;
    skos:prefLabel "virtual research environment"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Workflow> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "series of actions necessary to complete a task"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:prefLabel "workflow"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Access> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources, incl. ESFRI Report on Access to Research Infrastructures and Charter on Access to RIs;     https://zenodo.org/doi/10.5281/zenodo.10533244" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "protocol for availability of research data and services to users"@en ;
    skos:example "Listed in the Access Charter:  machine time, computing resources, software, data, data-communication services, trust and authentication services, sample preparation, archives, collections, the set-up, execution and dismantling of experiments, education and training, expert support and analytical services"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/OpenAccess> ;
    skos:note "The ESFRI report distinguishes a diversity of access types (physical, remote, virtual) and nature of services offered. Access policies (open, restricted) is dependent on a range of conditions, including ownership and sensitivity issues."@en ;
    skos:prefLabel "access"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/CertifiedRepository> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Repository> ;
    skos:definition "digital data archive that has been evaluated and approved by an independent authority to meet standards for reliability, data integrity, and long-term preservation"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/TrustedDigitalRepository> ;
    skos:note "Repository certification, such as CoreTrustSeal, offers to any interested data repository a core level certification based on the Core Trustworthy Data Repositories (TDR) requirements."@en ;
    skos:prefLabel "certified repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Component> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources, incl. OSCARS D2.1 - Clusters' Services and Data Sources Portfolios; https://zenodo.org/records/14881627" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Resource> ;
    skos:definition "resource that functions independently but that can be easily assembled or reconfigured with other resources to create new workflows or applications"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Data> ;
    skos:prefLabel "component"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DigitalInfrastructure> a skos:Concept ;
    dc:source "EOSC Glossary September 2020" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "infrastructure constituted by a physical layer (hardware) and an abstraction layer (software) that is based on the physical one"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataInfrastructure> ;
    skos:note "Digital infrastructures, unlike physical ones, are generative: they can be used recursively to create new digital infrastructures."@en ;
    skos:prefLabel "digital infrastructure"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DomainRepository> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ResearchDataRepository>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ThematicService> ;
    skos:definition "data repository​ with records for a specific discipline or disciplinary domain"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:prefLabel "domain repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCAMember> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources; see also https://eosc.eu/members" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "European ​legal entity​ admitted to the ​EOSC Association​ with full voting rights in the EOSC General Assembly"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCAMandatedOrganisation> ;
    skos:prefLabel "EOSC-A Member"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCTripartiteGovernance> a skos:Concept ;
    dc:source "https://eosc.eu/tripartite-collaboration" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "strategic coordination structure between the EU, represented by the Commission, the EOSC Association, and the Member States and Associated Countries to resource and support the implementation of the EOSC environment in Europe"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCNationalTripartitieEvent> ;
    skos:note "The Member States and Associated Countries are represented by the EOSC Steering Board."@en,
        "The aim is: advancing the Open Science system and aligning national and EU policies to improve the production of FAIR research output."@en ;
    skos:prefLabel "EOSC Tripartite Governance"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EuropeanPartnership> a skos:Concept ;
    dc:source "https://www.era-learn.eu/partnerships-in-a-nutshell/european-partnerships" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "initiative in which the EU Commission and private and/or public partners commit themselves to jointly support the development and implementation of a research and innovation programme"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCPartnership> ;
    skos:prefLabel "European Partnership"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/FAIRData> a skos:Concept ;
    dc:source "EOSC Glossary September 2020" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Data> ;
    skos:definition "data​ that conform to the ​FAIR principles​"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/FAIRPrinciples> ;
    skos:prefLabel "FAIR data"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/HorizontalService> a skos:Concept ;
    dc:source "Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Resource>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Service> ;
    skos:definition "cross-disciplinary infrastructure resource that is designed to support researchers across all scientific domains"@en ;
    skos:example "Horizontal services include virtual machines, cloud containers, bulk data transfer, file synchronisation and sharing, notebooks, and large file transfer."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:note "The terms 'common service' and 'generic service' are in use as synonym for 'horizontal service'.  The complement is 'thematic service'."@en ;
    skos:prefLabel "horizontal service"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ResearchInfrastructure> a skos:Concept ;
    dc:source "EOSC Glossary September 2020" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:altLabel "RI"@en ;
    skos:definition "infrastructure enabling the research communities to conduct research and foster innovation in their fields"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ThematicInfrastructure> ;
    skos:prefLabel "research infrastructure"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/TrustedDigitalRepository> a skos:Concept ;
    dc:source "EOSC Glossary September 2020" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:altLabel "TDR"@en,
        "trustworthy digital repository"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/CertifiedRepository> ;
    skos:definition "repository​ certfied according to ISO standard16363 or the CoreTrustSeal Trustworthy Data Repositories requirements"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/TRUSTPrinciples> ;
    skos:prefLabel "trusted digital repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCResourceCatalogue> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "catalogue of all EOSC resources, the result of integrating the EOSC service catalogue and the EOSC research product catalogue"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCResearchProductCatalogue>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCServiceCatalogue> ;
    skos:note "The catalogue is hosted by the EU Node and enables the discovery and access of resources provided through EOSC Nodes within the EOSC"@en ;
    skos:prefLabel "EOSC resource catalogue"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Repository> a skos:Concept ;
    dc:source "https://forrt.org/glossary/english/repository/" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Service> ;
    skos:definition "online archive for the storage of digital objects including research outputs, manuscripts, analysis code and/or data"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/CertifiedRepository>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ResearchDataRepository> ;
    skos:note "Repository data may a include wide range of data type, including publications."@en ;
    skos:prefLabel "repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ResearchDataRepository> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Repository> ;
    skos:definition "service supporting the storage, management, preservation, discovery, and access of research datasets and associated metadata to enable research data sharing and reuse"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DomainRepository>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/GenericRepository> ;
    skos:note "Research data repositories can be generic, institutional, thematic or domain-specific."@en ;
    skos:prefLabel "research data repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ThematicService> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Resource>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Service> ;
    skos:definition "service that provides discipline or domain-specific capabilities for a particular scientific community"@en ;
    skos:example "browsing and downloading data and apps, workflow development and execution, online analytics, result visualisation, sharing of result data"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DomainRepository> ;
    skos:note "The complement of 'thematic service' is 'generic service'."@en ;
    skos:prefLabel "thematic service"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/AdministrativeMetadata> a skos:Concept ;
    dc:source "EOSC Glossary September 2020" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Metadata> ;
    skos:definition "metadata​ necessary to allow the proper management of a ​resource​ in a ​repository​"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ProvenanceMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/RightsMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/TechnicalMetadata> ;
    skos:note "Administrative metadata can be categorised as ​provenance or context metadata​, ​technical​ and ​rights metadata​."@en ;
    skos:prefLabel "administrative metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataManagement> a skos:Concept ;
    dc:source "EOSC Glossary September 2020" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "activities of defining, creating, storing, maintaining and providing access to ​data​ and associated processes in one or more information systems"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataCuration>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataManagementPlan>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DataStewardship> ;
    skos:prefLabel "data management"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EOSCNode> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "organisation that complies with the EOSC Federation policies and legal framework, and shares resources at the local, national, regional, thematic or European level"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EInfrastructureEOSCNode>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/EUNode>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/NationalEOSCNode>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ThematicEOSCNode> ;
    skos:note "An EOSC Node offers resources that provide added value to the EOSC Federation and implements Federating Capabilities in collaboration with other EOSC Nodes. Each EOSC Node is responsible for its autonomy, governance and resources. It operates its own platform, complying with the EOSC IF technical framework, and the EOSC Node architecture."@en ;
    skos:prefLabel "EOSC Node"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Metadata> a skos:Concept ;
    dc:source "\"OSCARS Glossary Task Force 2026, based on several sources, among which \"CODATA RDM Terminology: https://vocabs.ardc.edu.au/repository/api/lda/codata/codata-research-data-management-terminology/current/resource?uri=https://terms.codata.org/rdmt/metadata" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Data> ;
    skos:definition "data that defines and describes the characteristics of other data"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/AdministrativeMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/DescriptiveMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/PreservationMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/StructuralMetadata> ;
    skos:note "Metadata can be categorised as ​descriptive​, ​structural​, ​preservation​ and administrative metadata​."@en ;
    skos:prefLabel "metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Resource> a skos:Concept ;
    dc:source "OSCARS Glossary Task Force 2026, based on several sources" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "digital or physical asset—including services, data, and people—needed to support open science and research"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Component>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/HorizontalService>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/ThematicService>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/TrainingResource> ;
    skos:note "In the context of EOSC, resources are understood to be both digital or analogue. They are produced or operated by or of potential use to researchers. Services include data sources, computational resources and data storage resources."@en ;
    skos:prefLabel "resource"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/Service> a skos:Concept ;
    dc:source "EOSC Future project glossary" ;
    dct:created "2026-10-15"^^xsd:date ;
    dct:modified "2026-10-15"^^xsd:date ;
    skos:definition "means of delivering value to customers by facilitating outcomes customers want to achieve without the ownership of specific costs and risks"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars-eosc/AuthenticationAndAuthorisationInfrastructure>,
